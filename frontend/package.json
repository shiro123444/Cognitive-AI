  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.13.2",
    "d3": "^7.9.0",
    "gsap": "^3.15.0",
    "pinia": "^2.3.1",
    "three": "^0.184.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.1",
    "vitest": "^2.1.9"
  }
