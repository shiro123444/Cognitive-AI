{
  "name": "cognitive-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "main": "./dist/edufish-vue.umd.js",
