# EDUFISH Engine — environment variables template
# Copy this file to .env and fill in your values.

# ── Engine identity ──────────────────────────────────────────────────────────
ENGINE_NAME=EDUFISH
ENGINE_API_KEY=
CORS_ORIGINS=http://localhost:3025

# ── Ports ────────────────────────────────────────────────────────────────────
ENGINE_PORT=5001
FRONTEND_PORT=3025

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///app.sqlite

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL_NAME=mimo-v2.5-pro

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMADB_DIR=/app/instance/chromadb

# ── Enterprise features ──────────────────────────────────────────────────────
# Set to "true" or "1" to enable
RATE_LIMIT_ENABLED=false
MULTI_TENANT_ENABLED=false
