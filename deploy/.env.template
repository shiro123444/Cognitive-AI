# EDUFISH Engine — environment variables template
# Copy this file to .env and fill in your values.
#   cp deploy/.env.template deploy/.env
# deploy/.env is gitignored — never commit real keys.

# ── Engine identity ──────────────────────────────────────────────────────────
ENGINE_NAME=EDUFISH
ENGINE_API_KEY=
CORS_ORIGINS=http://localhost:3025

# ── Ports ────────────────────────────────────────────────────────────────────
ENGINE_PORT=5001
FRONTEND_PORT=3025

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///app.sqlite

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
# Used by the Python engine (chat / agents). Any OpenAI-compatible endpoint works:
# OpenAI, DeepSeek, NVIDIA NIM, Xiaomi MiMo, Ollama /v1, etc.
#
# DeepSeek example (OpenAI path, NOT Anthropic Messages):
#   LLM_API_KEY=<your-deepseek-key>
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL_NAME=deepseek-v4-flash
#
# If you only have Anthropic-style env names from a Claude client:
#   ANTHROPIC_AUTH_TOKEN  -> LLM_API_KEY / RUNTIME_LLM_API_KEY
#   ANTHROPIC_BASE_URL    -> use the OpenAI base (…/v1), not …/anthropic
#   ANTHROPIC_DEFAULT_*   -> LLM_MODEL_NAME / RUNTIME_LLM_MODEL
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL_NAME=mimo-v2.5-pro

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMADB_DIR=/app/instance/chromadb

# ── Enterprise features ──────────────────────────────────────────────────────
# Set to "true" or "1" to enable
RATE_LIMIT_ENABLED=false
MULTI_TENANT_ENABLED=false

# ── Agent Runtime (Node) ─────────────────────────────────────────────────────
RUNTIME_PORT=4000
RUNTIME_DATABASE_URL=postgresql://edufish:edufish@postgres:5432/edufish_runtime
CAPABILITY_BASE_URL=http://engine:5001
# faux = offline smoke; openai = real LLM闭环 (requires key + model below)
RUNTIME_PROVIDER=faux
# When RUNTIME_PROVIDER=openai, fill these (OpenAI-compatible chat/completions).
# Tool names with dots (runtime.delegate) are wire-encoded automatically.
RUNTIME_LLM_BASE_URL=https://api.xiaomimimo.com/v1
RUNTIME_LLM_API_KEY=
RUNTIME_LLM_MODEL=mimo-v2.5-pro
POSTGRES_USER=edufish
POSTGRES_PASSWORD=edufish
POSTGRES_DB=edufish_runtime

# ── Real LLM e2e ─────────────────────────────────────────────────────────────
# After filling keys above:
#   bash deploy/verify-runtime-e2e.sh              # single agent (tutor + tools)
#   MODE=multi bash deploy/verify-runtime-e2e.sh   # supervisor + runtime.delegate
# If Docker Hub is unreachable, run postgres/engine/runtime locally with the same
# env vars (see previous session notes) — provider path is identical.
