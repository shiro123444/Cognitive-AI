# EDUFISH Engine — environment variables template
# Copy this file to .env and fill in your values.

# ── Engine identity ──────────────────────────────────────────────────────────
ENGINE_NAME=EDUFISH
ENGINE_API_KEY=
CORS_ORIGINS=http://localhost:3025

# ── Ports ────────────────────────────────────────────────────────────────────
ENGINE_PORT=5001
FRONTEND_PORT=3025

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///app.sqlite

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL_NAME=mimo-v2.5-pro

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMADB_DIR=/app/instance/chromadb

# ── Enterprise features ──────────────────────────────────────────────────────
# Set to "true" or "1" to enable
RATE_LIMIT_ENABLED=false
MULTI_TENANT_ENABLED=false

# ── Agent Runtime (Node) ─────────────────────────────────────────────────────
RUNTIME_PORT=4000
RUNTIME_DATABASE_URL=postgresql://edufish:edufish@postgres:5432/edufish_runtime
CAPABILITY_BASE_URL=http://engine:5001
RUNTIME_PROVIDER=faux
# When RUNTIME_PROVIDER=openai, fill these (any OpenAI-compatible endpoint:
# OpenAI, NVIDIA NIM, Xiaomi MiMo, Ollama /v1, etc.)
RUNTIME_LLM_BASE_URL=https://api.xiaomimimo.com/v1
RUNTIME_LLM_API_KEY=
RUNTIME_LLM_MODEL=mimo-v2.5-pro
POSTGRES_USER=edufish
POSTGRES_PASSWORD=edufish
POSTGRES_DB=edufish_runtime
